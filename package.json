{
  "name": "the-assembly",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "node scripts/deploy.mjs production",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:bootstrap": "wrangler d1 execute DB --local --file database/bootstrap.sql",
    "db:demo": "wrangler d1 execute DB --local --file database/demo.sql",
    "db:export:floot": "node scripts/export-postgres.mjs",
    "db:prepare-import": "node scripts/prepare-import.mjs",
    "cloudflare:provision": "node --use-env-proxy scripts/provision-cloudflare.mjs",
    "cf:types": "wrangler types worker/bindings.d.ts --env-interface AssemblyBindings --include-runtime false --strict-vars false",
    "cf:types:check": "wrangler types worker/bindings.d.ts --env-interface AssemblyBindings --include-runtime false --strict-vars false --check"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.52.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261006.0-alpha",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  }
}
